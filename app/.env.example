# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_...). It's public by design; security comes from the
# row-level security rules in supabase/schema.sql. (Older projects: the legacy "anon" key also works,
# as VITE_SUPABASE_ANON_KEY.)
# NEVER put the secret key (sb_secret_...) or the legacy service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
